{
  "name": "LifeOS",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13",
  "postCreateCommand": "pip install -r requirements.txt",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": { "label": "LifeOS gateway", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
