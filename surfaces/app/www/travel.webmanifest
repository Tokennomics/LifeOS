{
  "name": "LifeOS Travel",
  "short_name": "LifeOS Travel",
  "description": "Run your week offline: vision, weekly plan, daily log, retro, capture — all on your phone, no server.",
  "start_url": "./travel.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0F1420",
  "theme_color": "#0F1420",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Capture a thought", "short_name": "Capture", "url": "./travel.html?tab=capture",
      "description": "Jump straight to the capture box" }
  ],
  "share_target": {
    "action": "./travel.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
