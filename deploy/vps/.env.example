# Copy to .env (gitignored, chmod 600) and fill in. Never commit the real file.
#
# The compose file only ever names these variables — no value in this repo, ever.

# --- required ---------------------------------------------------------------
LIFEOS_DOMAIN=lifeos.example.com
LIFEOS_ACME_EMAIL=you@example.com

# Generate, don't invent:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LIFEOS_GATEWAY_TOKEN=

# Signs payloads (modules/security/crypto_tokens.py). There is deliberately NO default:
# a signing key with a published fallback signs nothing. Generate a second, different value.
LIFEOS_SIGNING_KEY=

# Dating (ROADMAP Phase 3b). Off unless this is literally 1/true/yes/on. The two gates
# code cannot satisfy are G0 (this box, reachable, with TLS and backups) and G4 (at least
# two people who actually asked for it) — turning this on asserts both. Everything else
# about the surface fails closed on its own: no signing key above, no dating either.
LIFEOS_DATING_ENABLED=

# --- optional: every feature works without these -----------------------------
# Tier 2 event listings (ROADMAP → Event aggregation). Without it the providers report
# `not_configured` and contribute nothing — venue feeds and crew nights still fill the
# weekend digest. Coverage is ticketed and mainstream: it finds the arena show and misses
# the basement party. Free key from developer.ticketmaster.com.
LIFEOS_TICKETMASTER_KEY=

ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
LIFEOS_CALENDAR_ICS=
